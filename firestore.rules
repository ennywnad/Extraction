rules_version = '2';

// Deny all direct client access. Every read and write goes through the Express server
// using the Firestore Admin SDK, which bypasses these rules entirely — so this file costs
// nothing today and stops a future client-side SDK from reaching the pile directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
