holder=\"e.g., Actually, six months of silence would lose us prime momentum...\"\n              value={response}\n              onChange={(e) => setResponse(e.target.value)}\n              onKeyDown={(e) => e.key === \"Enter\" && response.trim() && handleSave()}\n              className=\"w-full text-sm border border-slate-205 focus:ring-2 focus:ring-amber-500/10 focus:border-amber-500 rounded-xl p-3\"\n            />\n          </div>\n\n          <div className=\"flex justify-end gap-2 text-xs\">\n            <button\n              onClick={() => setCurrentIndex((prev) => prev + 1)}\n              className=\"px-4 py-2 border rounded-xl hover:bg-slate-50 text-slate-500\"\n            >\n              Skip Challenge\n            </button>\n            <button\n              disabled={!response.trim()}\n              onClick={handleSave}\n              className=\"px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl font-semibold text-xs flex items-center gap-1.5 transition cursor-pointer\"\n            >\n              <Send className=\"w-3.5 h-3.5\" />\n              Capture Reaction\n            </button>\n          </div>\n        </div>\n      ) : (\n        <div className=\"text-center py-12 p-8 space-y-4\">\n          <div className=\"p-3 bg-emerald-50 text-emerald-600 border border-emerald-100 rounded-2xl inline-block\">\n            <Check className=\"w-8 h-8\" />\n          </div>\n          <h2 className=\"text-base font-bold text-slate-800\">Pressure Test Completed!</h2>\n          <p className=\"text-xs text-slate-500\">Your defensive core lines have been stockpiled. Synthesize results now!</p>\n        </div>\n      )}\n    </div>"
