        }
        lines {
          text: "    else if (e.key === \"ArrowLeft\") handleSwipe(\"dislike\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    else if (e.key === \"ArrowDown\") handleSwipe(\"maybe\");"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
