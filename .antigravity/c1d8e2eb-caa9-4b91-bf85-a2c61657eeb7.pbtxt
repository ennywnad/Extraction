ono font-bold text-zinc-700 uppercase tracking-wider\">Your direct, honest defense:</span>\n            <input\n              type=\"text\"\n              placeholder=\"e.g., Actually, six months of silence would lose us prime momentum...\"\n              value={response}\n              onChange={(e) => setResponse(e.target.value)}\n              onKeyDown={(e) => e.key === \"Enter\" && response.trim() && handleSave()}\n              className=\"w-full text-xs font-mono border-2 border-black bg-white p-3.5 focus:outline-none\"\n            />\n          </div>\n\n          <div className=\"flex justify-end gap-2 text-xs\">\n            <button\n              onClick={() => setCurrentIndex((prev) => prev + 1)}\n              className=\"px-4 py-2 hover:underline text-black font-display font-bold uppercase tracking-wider cursor-pointer\"\n            >\n              Skip Challenge\n            </button>\n            <button\n              disabled={!response.trim()}\n              onClick={handleSave}\n              className=\"px-5 py-2.5 border-2 border-black bg-black text-white hover:bg-[#F8F7F4] hover:text-black font-display font-black text-xs uppercase tracking-wider flex items-center gap-1.5 transition cursor-pointer shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]\"\n            >\n              <Send className=\"w-3.5 h-3.5\" />\n              Capture Reaction\n            </button>\n          </div>\n        </div>\n      ) : (\n        <div className=\"text-center py-12 p-8 space-y-4 border-2 border-dashed border-zinc-300\">\n          <div className=\"p-3 bg-black text-white border border-black inline-block\">\n            <Check className=\"w-8 h-8\" />\n          </div>\n          <h2 className=\"text-sm font-display font-black uppercase text-black\">Pressure Test Completed!</h2>\n          <p className=\"text-xs text-zinc-500 font-sans max-w-xs mx-auto\">Your defensive core lines have been stockpiled. Synthesize results now!</p>\n        </div>\n      )}\n    </div>"
