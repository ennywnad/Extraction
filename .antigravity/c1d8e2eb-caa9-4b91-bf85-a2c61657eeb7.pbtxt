  file_change {
    absolute_path_uri: "file:///src/index.css"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Playfair+Display:ital,wght@0,600;0,800;1,400;1,700&family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;700&display=swap\');\n@import \"tailwindcss\";\n\n@theme {\n  --font-sans: \"Inter\", ui-sans-serif, system-ui, sans-serif;\n  --font-display: \"Space Grotesk\", sans-serif;\n  --font-serif: \"Playfair Display\", Georgia, serif;\n  --font-mono: \"JetBrains Mono\", monospace;\n  \n  --color-bento-bg: #F8F7F4;\n  --color-bento-card: #FFFFFF;\n  --color-bento-gray: #EFEFEF;\n  --color-bento-primary: #1A1A1A;\n  --color-bento-accent: #FF5722;\n  --color-bento-accent-light: #FDF2EE;\n}\n\n/* Custom global overrides to inject the gorgeous Bento grid look */\nbody {\n  background-color: var(--color-bento-bg);\n  color: var(--color-bento-primary);\n  font-family: var(--font-sans);\n}\n\n/* Base Bento Card and UI styles */\n.bento-card {\n  background-color: var(--color-bento-card);\n  border: 2px solid var(--color-bento-primary);\n  box-shadow: 4px 4px 0px 0px var(--color-bento-primary);\n  transition: all 0.2s ease-in-out;\n}\n\n.bento-card:hover {\n  transform: translate(-2px, -2px);\n  box-shadow: 6px 6px 0px 0px var(--color-bento-primary);\n}\n\n.bento-btn {\n  background-color: var(--color-bento-primary);\n  color: #FFFFFF;\n  border: 2px solid var(--color-bento-primary);\n  font-family: var(--font-display);\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  transition: all 0.2s ease-in-out;\n}\n\n.bento-btn:hover:not(:disabled) {\n  background-color: #FFFFFF;\n  color: var(--color-bento-primary);\n}\n\n.bento-btn-secondary {\n  background-color: #FFFFFF;\n  color: var(--color-bento-primary);\n  border: 2px solid var(--color-bento-primary);\n  font-family: var(--font-display);\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.1em;\n  transition: all 0.2s ease-in-out;\n}\n\n.bento-btn-secondary:hover:not(:disabled) {\n  background-color: var(--color-bento-primary);\n  color: #FFFFFF;\n}\n\n/* Background grid motif */\n.bento-pattern {\n  background-image: radial-gradient(var(--color-bento-primary) 1.5px, transparent 0);\n  background-size: 24px 24px;\n}\n"
    }
