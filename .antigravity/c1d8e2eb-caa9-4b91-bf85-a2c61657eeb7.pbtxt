  file_change {
    absolute_path_uri: "file:///src/components/Modes/DevilsAdvocate.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useEffect } from \"react\";\nimport { ShieldAlert, RefreshCw, Send, Check } from \"lucide-react\";\nimport { Thought } from \"../../types\";\n\ninterface DevilsAdvocateProps {\n  topic: string;\n  onAddThought: (text: string) => void;\n  thoughts: Thought[];\n}\n\nexport default function DevilsAdvocate({ topic, onAddThought, thoughts }: DevilsAdvocateProps) {\n  const [challenges, setChallenges] = useState<string[]>([]);\n  const [currentIndex, setCurrentIndex] = useState(0);\n  const [response, setResponse] = useState(\"\");\n  const [loading, setLoading] = useState(false);\n\n  useEffect(() => {\n    fetchChallenges();\n  }, [topic]);\n\n  const fetchChallenges = async () => {\n    setLoading(true);\n    try {\n      const res = await fetch(\"/api/session/devils-advocate\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          topic,\n          recentThoughts: thoughts.slice(0, 8),\n        }),\n      });\n      if (res.ok) {\n        const data = await res.json();\n        if (data.challenges && data.challenges.length > 0) {\n          setChallenges(data.challenges);\n        }\n      }\n    } catch (e) {\n      console.error(e);\n      setChallenges([\n        \"Are you using this process to avoid a different, much harder decision?\",\n        \"If you do absolutely nothing about this for six months, what would actually break?\",\n        \"Is there a chance your standard of \'success\' here is actually unrealistic?\"\n      ]);\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  const handleSave = () => {\n    if (!response.trim()) return;\n    const challenge = challenges[currentIndex];\n    onAddThought(`Pressure-Test Challenge: [${challenge}] -> Response: [${response.trim()}]`);\n    setResponse(\"\");\n\n    if (currentIndex < challenges.length - 1) {\n      setCurrentIndex((prev) => prev + 1);\n    } else {\n      setCurrentIndex((prev) => prev + 1);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\" id=\"devils-advocate-mode\">\n      <div className=\"bg-slate-50 border border-slate-100 p-4.5 rounded-2xl flex items-start gap-4\">\n        <ShieldAlert className=\"w-5 h-5 text-amber-600 shrink-0 mt-0.5\" />\n        <div className=\"flex-1\">\n          <h3 className=\"font-semibold text-xs text-slate-800\">Devil\'s Advocate</h3>\n          <p className=\"text-[11px] text-slate-500 leading-normal mt-0.5\">\n            Pressure-test opinions or comfort zones. Respond directly to uncomfortable counterarguments generated by Gemini to lock down what you truly believe.\n          </p>\n        </div>\n        <button\n          onClick={fetchChallenges}\n          className=\"p-1 px-2.5 bg-amber-50 hover:bg-amber-100 border border-amber-200 text-amber-700 text-[10px] font-bold rounded-lg\"\n          disabled={loading}\n        >\n          Re-Analyze\n        </button>\n      </div>\n\n      {loading ? (\n        <div className=\"py-12 text-center text-slate-400 flex flex-col items-center justify-center gap-2\">\n          <RefreshCw className=\"w-5 h-5 animate-spin text-amber-600\" />\n          <span className=\"text-xs font-semibold\">Generating critical pressure-challenges...</span>\n        </div>\n      ) : currentIndex < challenges.length ? (\n        <div className=\"space-y-4\">\n          <div className=\"p-5 bg-amber-50/50 border border-amber-150/40 rounded-2xl\">\n            <span className=\"text-[10px] uppercase font-bold tracking-wider text-amber-600 block mb-1.5\">Challenge {currentIndex+1} of {challenges.length}</span>\n            <p className=\"text-sm font-bold text-slate-800\">\n              \"{challenges[currentIndex]}\"\n            </p>\n          </div>\n\n          <div className=\"space-y-2\">\n            <span className=\"block text-xs font-semibold text-slate-600\">Your direct, honest response defend:</span>\n            <input\n              type=\"text\"\n              placeholder=\"e.g., Actually, six months of silence would lose us prime momentum...\"\n              value={response}\n              onChange={(e) => setResponse(e.target.value)}\n              onKeyDown={(e) => e.key === \"Enter\" && response.trim() && handleSave()}\n              className=\"w-full text-sm border border-slate-205 focus:ring-2 focus:ring-amber-500/10 focus:border-amber-500 rounded-xl p-3\"\n            />\n          </div>\n\n          <div className=\"flex justify-end gap-2 text-xs\">\n            <button\n              onClick={() => setCurrentIndex((prev) => prev + 1)}\n              className=\"px-4 py-2 border rounded-xl hover:bg-slate-50 text-slate-500\"\n            >\n              Skip Challenge\n            </button>\n            <button\n              disabled={!response.trim()}\n              onClick={handleSave}\n              className=\"px-5 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl font-semibold text-xs flex items-center gap-1.5 transition cursor-pointer\"\n            >\n              <Send className=\"w-3.5 h-3.5\" />\n              Capture Reaction\n            </button>\n          </div>\n        </div>\n      ) : (\n        <div className=\"text-center py-12 p-8 space-y-4\">\n          <div className=\"p-3 bg-emerald-50 text-emerald-600 border border-emerald-100 rounded-2xl inline-block\">\n            <Check className=\"w-8 h-8\" />\n          </div>\n          <h2 className=\"text-base font-bold text-slate-800\">Pressure Test Completed!</h2>\n          <p className=\"text-xs text-slate-500\">Your defensive core lines have been stockpiled. Synthesize results now!</p>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
