        target_content: "    <div className=\"space-y-6 flex flex-col h-[520px]\" id=\"guided-drill-mode\">\n      \n      {/* Header Info */}\n      <div className=\"bg-slate-50 border border-slate-100 p-4 rounded-2xl flex items-start gap-4 shrink-0\">\n        <HelpCircle className=\"w-5 h-5 text-indigo-500 shrink-0 mt-0.5\" />\n        <div>\n          <h3 className=\"font-semibold text-xs text-slate-800\">Guided Drill</h3>\n          <p className=\"text-[11px] text-slate-500 leading-normal mt-0.5\">\n            A conversational, adaptive expert interview. Your responses paint the picture; each question digs deeper.\n          </p>\n        </div>\n      </div>\n\n      {/* Interactive Conversation Timeline Thread block */}\n      <div className=\"flex-1 overflow-y-auto border border-slate-200/80 rounded-2xl bg-slate-50 p-4 space-y-4 shadow-2xs custom-scrollbar\">\n        {qaHistory.map((h, i) => (\n          <div key={i} className=\"space-y-2\">\n            {/* AI Bubble */}\n            <div className=\"flex items-start max-w-[85%]\">\n              <div className=\"bg-white border border-slate-150 p-3 rounded-2xl text-xs text-slate-800 shadow-2xs\">\n                {h.question}\n              </div>\n            </div>\n            {/* User Bubble */}\n            <div className=\"flex items-start justify-end\">\n              <div className=\"bg-indigo-650 text-white p-3 rounded-2xl text-xs max-w-[85%] shadow-2xs font-normal\">\n                {h.answer}\n              </div>\n            </div>\n          </div>\n        ))}\n\n        {/* Current Active Question Bubble */}\n        {currentQuestion && !loading && (\n          <motion.div\n            initial={{ opacity: 0, scale: 0.95 }}\n            animate={{ opacity: 1, scale: 1 }}\n            className=\"space-y-1.5 max-w-[85%]\"\n          >\n            {contextNote && (\n              <span className=\"text-[9px] uppercase font-bold tracking-widest text-indigo-500 bg-indigo-50 px-2 py-0.5 rounded-full ml-1\">\n                \360\237\224\254 Focus: {contextNote}\n              </span>\n            )}\n            <div className=\"bg-white border border-indigo-150/80 p-4 rounded-2xl text-xs text-slate-800 shadow-xs border-l-4 border-l-indigo-500\">\n              {currentQuestion}\n            </div>\n          </motion.div>\n        )}\n\n        {loading && (\n          <div className=\"flex items-start max-w-[85%]\">\n            <div className=\"bg-white border border-slate-200 p-3.5 rounded-2xl text-xs text-slate-450 italic flex items-center gap-2\">\n              <RefreshCw className=\"w-3.5 h-3.5 animate-spin text-indigo-500\" />\n              Mapping associations and drafting next line...\n            </div>\n          </div>\n        )}\n\n        <div ref={threadEndRef} />\n      </div>\n\n      {/* Input panel block */}\n      <div className=\"space-y-2.5 shrink-0\">\n        <div className=\"flex gap-2\">\n          <input\n            type=\"text\"\n            placeholder={loading ? \"Generating next thought query...\" : \"Formulate your thoughtful response here...\"}\n            value={answerDraft}\n            onChange={(e) => setAnswerDraft(e.target.value)}\n            onKeyDown={(e) => e.key === \"Enter\" && !loading && handleSendAnswer()}\n            disabled={loading}\n            className=\"flex-1 text-xs border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-515/10 focus:border-indigo-500 bg-white\"\n          />\n          <button\n            disabled={!answerDraft.trim() || loading}\n            onClick={handleSendAnswer}\n            className=\"px-4.5 py-2.5 bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 text-white rounded-xl text-xs font-semibold flex items-center gap-1 shadow-2xs transition cursor-pointer\"\n          >\n            <Send className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        <div className=\"flex items-center justify-between\">\n          <span className=\"text-[10px] text-slate-400\">\n            Tip: Say as much or as little as you\'d like. Be honest.\n          </span>\n          <button\n            onClick={handleSkipQuestion}\n            className=\"text-xs text-indigo-600 hover:underline cursor-pointer\"\n            disabled={loading}\n          >\n            Pivot / Skip question\n          </button>\n        </div>\n      </div>\n    </div>"
        replacement_content: "    <div className=\"space-y-6 flex flex-col h-[520px]\" id=\"guided-drill-mode\">\n      \n      {/* Header Info */}\n      <div className=\"bg-white border-3 border-black p-4 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex items-start gap-4 shrink-0\">\n        <HelpCircle className=\"w-5 h-5 text-black shrink-0 mt-0.5\" />\n        <div>\n          <h3 className=\"font-display font-black text-xs uppercase text-black tracking-wider\">Guided Drill Interview</h3>\n          <p className=\"text-[11px] text-zinc-650 leading-normal mt-0.5 font-sans\">\n            A conversational, adaptive expert interview. Your responses paint the picture; each question digs deeper.\n          </p>\n        </div>\n      </div>\n\n      {/* Interactive Conversation Timeline Thread block */}\n      <div className=\"flex-1 overflow-y-auto border-3 border-black bg-[#F8F7F4] p-4 space-y-4 custom-scrollbar\">\n        {qaHistory.map((h, i) => (\n          <div key={i} className=\"space-y-3\">\n            {/* AI Bubble */}\n            <div className=\"flex items-start max-w-[85%]\">\n              <div className=\"bg-white border-2 border-black p-3 rounded-none text-xs text-black font-sans\">\n                {h.question}\n              </div>\n            </div>\n            {/* User Bubble */}\n            <div className=\"flex items-start justify-end\">\n              <div className=\"bg-black text-white border border-black p-3 rounded-none text-xs max-w-[85%] font-mono\">\n                {h.answer}\n              </div>\n            </div>\n          </div>\n        ))}\n\n        {/* Current Active Question Bubble */}\n        {currentQuestion && !loading && (\n          <motion.div\n            initial={{ opacity: 0, scale: 0.98 }}\n            animate={{ opacity: 1, scale: 1 }}\n            className=\"space-y-2 max-w-[85%]\"\n          >\n            {contextNote && (\n              <span className=\"text-[8px] uppercase tracking-widest font-mono font-bold text-white bg-black px-2 py-0.5 inline-block\">\n                CRITICAL FOCUS // {contextNote}\n              </span>\n            )}\n            <div className=\"bg-white border-2 border-black border-l-8 border-l-black p-4 text-xs text-black font-sans\">\n              {currentQuestion}\n            </div>\n          </motion.div>\n        )}\n\n        {loading && (\n          <div className=\"flex items-start max-w-[85%]\">\n            <div className=\"bg-white border-2 border-black p-3.5 text-xs text-black font-mono italic flex items-center gap-2\">\n              <RefreshCw className=\"w-3.5 h-3.5 animate-spin text-black\" />\n              Mapping associations & retrieving deep follow-up...\n            </div>\n          </div>\n        )}\n\n        <div ref={threadEndRef} />\n      </div>\n\n      {/* Input panel block */}\n      <div className=\"space-y-3 shrink-0\">\n        <div className=\"flex gap-2.5\">\n          <input\n            type=\"text\"\n            placeholder={loading ? \"Formulating thread...\" : \"Respond to the question here...\"}\n            value={answerDraft}\n            onChange={(e) => setAnswerDraft(e.target.value)}\n            onKeyDown={(e) => e.key === \"Enter\" && !loading && handleSendAnswer()}\n            disabled={loading}\n            className=\"flex-1 text-xs border-2 border-black px-4 py-3 focus:outline-none bg-white font-mono text-black\"\n          />\n          <button\n            disabled={!answerDraft.trim() || loading}\n            onClick={handleSendAnswer}\n            className=\"px-5 py-3 border-2 border-black bg-black text-white hover:bg-white hover:text-black font-display font-black text-xs uppercase tracking-wider flex items-center justify-center cursor-pointer shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all\"\n          >\n            <Send className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n\n        <div className=\"flex items-center justify-between\">\n          <span className=\"text-[10px] text-zinc-500 font-mono uppercase tracking-wider\">\n            Tip: Respond freely. Your answers will enrich the Surfaced Pile.\n          </span>\n          <button\n            onClick={handleSkipQuestion}\n            className=\"text-xs uppercase font-extrabold tracking-wider font-display text-black hover:underline cursor-pointer\"\n            disabled={loading}\n          >\n            [Skip / Pivot Question]\n          </button>\n        </div>\n      </div>\n    </div>"
