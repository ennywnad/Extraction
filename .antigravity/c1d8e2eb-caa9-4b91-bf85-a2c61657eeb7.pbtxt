          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const shareableUrl = `${window.location.origin}/?snapshot=${stateBlob}`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    navigator.clipboard.writeText(shareableUrl);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    alert(\"Shareable Base64 session URL copied to clipboard! Share it with anyone; they can read your exact outline instantly without an account.\");"
