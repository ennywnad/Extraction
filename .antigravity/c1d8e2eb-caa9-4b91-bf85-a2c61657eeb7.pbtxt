    instruction: "Restyle the top title card, presets, text inputs and radio buttons to have a premium bento look"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"max-w-4xl mx-auto px-4 py-8 md:py-12\" id=\"intake-root\">\n      <div className=\"text-center mb-10 md:mb-12\">\n        <div className=\"inline-flex items-center justify-center bg-indigo-50 border border-indigo-100 rounded-2xl p-4.5 mb-5 shadow-sm text-indigo-600\">\n          <Brain className=\"w-10 h-10 animate-pulse text-indigo-600\" />\n        </div>\n        <h1 className=\"text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl font-sans\">\n          Extraction\n        </h1>\n        <p className=\"mt-4 text-lg text-slate-500 max-w-xl mx-auto\">\n          Unburden, organize, and map out your thoughts. Let\'s move from scattered ideas to structural lists and outlines.\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        {/* Main Intake Block */}\n        <div className=\"lg:col-span-2 space-y-8 bg-white border border-slate-200/80 rounded-2xl p-6 md:p-8 shadow-sm\">\n          <div>\n            <h2 className=\"text-lg font-semibold text-slate-950 flex items-center gap-2 mb-4\">\n              <Clipboard className=\"w-5 h-5 text-indigo-500\" />\n              1. What is this session about?\n            </h2>\n            \n            {/* Presets Grid */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3 mb-4\">\n              {PRESETS.map((p, i) => {\n                const Icon = p.icon;\n                return (\n                  <button\n                    key={i}\n                    onClick={() => handlePresetSelect(p)}\n                    className=\"flex text-left p-3.5 border border-slate-100 rounded-xl hover:border-indigo-400 hover:bg-indigo-50/20 active:bg-indigo-50/50 transition cursor-pointer\"\n                  >\n                    <Icon className=\"w-5 h-5 shrink-0 text-slate-400 mt-0.5 mr-3\" />\n                    <div>\n                      <span className=\"block font-medium text-xs text-slate-800\">{p.topic}</span>\n                      <span className=\"block text-[11px] text-slate-400 font-normal line-clamp-1\">{p.intention}</span>\n                    </div>\n                  </button>\n                );\n              })}\n            </div>\n\n            <textarea\n              id=\"topic-input\"\n              rows={3}\n              placeholder=\"e.g., Deciding on my product release plan, evaluating a hard conversation with my sibling, or putting together a side-project outline...\"\n              value={topic}\n              onChange={(e) => setTopic(e.target.value)}\n              className=\"w-full text-sm border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 placeholder:text-slate-400 bg-slate-50/30 transition\"\n            />\n          </div>\n\n          <div>\n            <h2 className=\"text-lg font-semibold text-slate-950 flex items-center gap-2 mb-4\">\n              <Smile className=\"w-5 h-5 text-indigo-500\" />\n              2. What do you want to get out of this?\n            </h2>\n            <div className=\"space-y-2\">\n              {[\n                { label: \"Organize raw thoughts into a structured markdown outline\", value: \"Organize raw thoughts into a structured markdown outline\" },\n                { label: \"Make a tough choice with clear priority action items\", value: \"Make a tough choice with clear priority action items\" },\n                { label: \"Decompress deep mental fog and find emotional peace\", value: \"Decompress deep mental fog and find emotional peace\" },\n                { label: \"custom\", labelOverride: \"Something else...\" },\n              ].map((opt) => (\n                <label\n                  key={opt.value || \"custom\"}\n                  className={`flex items-center gap-3 p-3 border rounded-xl cursor-pointer transition text-sm ${\n                    intention === opt.value || (opt.value === \"custom\" && intention === \"custom\")\n                      ? \"border-indigo-500 bg-indigo-50/30 font-medium text-slate-900\"\n                      : \"border-slate-100 hover:bg-slate-50/50 text-slate-600\"\n                  }`}\n                >\n                  <input\n                    type=\"radio\"\n                    name=\"intention\"\n                    checked={intention === opt.value || (opt.value === \"custom\" && intention === \"custom\")}\n                    onChange={() => setIntention(opt.value || \"custom\")}\n                    className=\"text-indigo-600 focus:ring-indigo-500 border-slate-300\"\n                  />\n                  {opt.labelOverride || opt.label}\n                </label>\n              ))}\n\n              <AnimatePresence>\n                {intention === \"custom\" && (\n                  <motion.div\n                    initial={{ opacity: 0, height: 0 }}\n                    animate={{ opacity: 1, height: \"auto\" }}\n                    exit={{ opacity: 0, height: 0 }}\n                    className=\"overflow-hidden\"\n                  >\n                    <input\n                      type=\"text\"\n                      placeholder=\"My custom intention holds...\"\n                      value={customIntention}\n                      onChange={(e) => setCustomIntention(e.target.value)}\n                      className=\"w-full text-sm border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\"\n                    />\n                  </motion.div>\n                )}\n              </AnimatePresence>\n            </div>\n          </div>"
        replacement_content: "  return (\n    <div className=\"max-w-5xl mx-auto px-4 py-8 md:py-12\" id=\"intake-root\">\n      {/* Title block bento card with monospace tag and serif description */}\n      <div className=\"bg-white border-3 border-black p-8 md:p-10 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] text-center relative overflow-hidden mb-8\">\n        <div className=\"absolute top-2 right-2 font-mono text-[9px] text-zinc-400 select-none\">\n          STRICT_ENG_BUILD_V1 // NO_TRANSLATIONS\n        </div>\n        <div className=\"inline-flex items-center justify-center bg-black text-white p-3.5 mb-4 border border-black shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]\">\n          <Brain className=\"w-8 h-8 text-white\" />\n        </div>\n        <h1 className=\"text-3xl font-black tracking-tight text-black sm:text-5xl font-display uppercase\">\n          E X T R A C T I O N\n        </h1>\n        <p className=\"mt-3 text-sm md:text-base text-zinc-700 max-w-xl mx-auto font-serif italic\">\n          \"Unburden, organize, and map out your thoughts. Let\'s move from scattered ideas to structural lists and outlines.\"\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Main Intake Block */}\n        <div className=\"lg:col-span-2 space-y-8 bg-white border-3 border-black p-6 md:p-8 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)]\">\n          <div>\n            <h2 className=\"text-base md:text-lg font-black text-black uppercase tracking-wider font-display flex items-center gap-2.5 mb-4\">\n              <span className=\"bg-black text-white px-2 py-0.5 text-xs font-mono\">01</span>\n              What is this session about?\n            </h2>\n            \n            {/* Presets Grid */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3 mb-4\">\n              {PRESETS.map((p, i) => {\n                const Icon = p.icon;\n                return (\n                  <button\n                    key={i}\n                    onClick={() => handlePresetSelect(p)}\n                    className=\"flex text-left p-3.5 border-2 border-black bg-white hover:bg-zinc-50 hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 transition-all cursor-pointer\"\n                  >\n                    <Icon className=\"w-5 h-5 shrink-0 text-black mt-0.5 mr-3\" />\n                    <div>\n                      <span className=\"block font-bold text-xs text-black\">{p.topic}</span>\n                      <span className=\"block text-[10px] text-zinc-500 font-normal line-clamp-1 mt-0.5\">{p.intention}</span>\n                    </div>\n                  </button>\n                );\n              })}\n            </div>\n\n            <textarea\n              id=\"topic-input\"\n              rows={3}\n              placeholder=\"e.g., Deciding on my product release plan, evaluating a hard conversation with my sibling, or putting together a side-project outline...\"\n              value={topic}\n              onChange={(e) => setTopic(e.target.value)}\n              className=\"w-full text-xs md:text-sm border-2 border-black p-3 focus:outline-none focus:bg-white bg-zinc-50/50 hover:bg-white transition-all font-mono\"\n            />\n          </div>\n\n          <div>\n            <h2 className=\"text-base md:text-lg font-black text-black uppercase tracking-wider font-display flex items-center gap-2.5 mb-4\">\n              <span className=\"bg-black text-white px-2 py-0.5 text-xs font-mono\">02</span>\n              What do you want to get out of this?\n            </h2>\n            <div className=\"space-y-2\">\n              {[\n                { label: \"Organize raw thoughts into a structured markdown outline\", value: \"Organize raw thoughts into a structured markdown outline\" },\n                { label: \"Make a tough choice with clear priority action items\", value: \"Make a tough choice with clear priority action items\" },\n     