  file_change {
    absolute_path_uri: "file:///src/components/IntakeForm.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \"react\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport {\n  Brain,\n  HelpCircle,\n  Clock,\n  Sparkles,\n  ArrowRight,\n  Gauge,\n  Clipboard,\n  Smile,\n  ChevronRight,\n  Trash2,\n  FolderOpen\n} from \"lucide-react\";\nimport { Session, ExtractionMode } from \"../types\";\n\ninterface IntakeFormProps {\n  onStartSession: (session: Partial<Session>) => void;\n  pastSessions: Session[];\n  onLoadSession: (id: string) => void;\n  onDeleteSession: (id: string) => void;\n}\n\nconst PRESETS = [\n  {\n    topic: \"Should I make a career pivot?\",\n    intention: \"Weighing risk against passion and deciding on next steps\",\n    icon: Sparkles,\n  },\n  {\n    topic: \"Unpacking a complex direct conversation with my team\",\n    intention: \"Decompress, separate facts from feelings, and plan my response\",\n    icon: HelpCircle,\n  },\n  {\n    topic: \"Structuring a brand new side project idea\",\n    intention: \"Fleshing out the feature list, target users, and first goals\",\n    icon: Brain,\n  },\n  {\n    topic: \"I feel incredibly scattered and overwhelmed head-to-toe today\",\n    intention: \"Just looking to dump the mental stack and identify immediate actions\",\n    icon: Gauge,\n  },\n];\n\nexport default function IntakeForm({\n  onStartSession,\n  pastSessions,\n  onLoadSession,\n  onDeleteSession,\n}: IntakeFormProps) {\n  const [topic, setTopic] = useState(\"\");\n  const [intention, setIntention] = useState(\"\");\n  const [customIntention, setCustomIntention] = useState(\"\");\n  const [showRecommendationQuiz, setShowRecommendationQuiz] = useState(false);\n\n  // Warmup Quiz answers\n  const [clarity, setClarity] = useState<\"clear\" | \"foggy\" | \"\">(\"\");\n  const [nature, setNature] = useState<\"emotional\" | \"analytical\" | \"\">(\"\");\n  const [timeAvailable, setTimeAvailable] = useState<\"<5\" | \">20\" | \"\">(\"\");\n  const [intentType, setIntentType] = useState<\"decide\" | \"process\" | \"capture\" | \"\">(\"\");\n\n  const [loadingRecommendation, setLoadingRecommendation] = useState(false);\n  const [recommendationResult, setRecommendationResult] = useState<{\n    recommendation: ExtractionMode;\n    rationale: string;\n    alternativeModes: ExtractionMode[];\n  } | null>(null);\n\n  const handlePresetSelect = (preset: typeof PRESETS[0]) => {\n    setTopic(preset.topic);\n    setIntention(preset.intention);\n  };\n\n  const getQuickRecommendationLocally = (): {\n    recommendation: ExtractionMode;\n    rationale: string;\n    alternativeModes: ExtractionMode[];\n  } => {\n    // Fallback recommendation logic matched from the Design Doc criteria\n    if (clarity === \"foggy\") {\n      if (nature === \"emotional\") {\n        return {\n          recommendation: \"free_stream\",\n          rationale: \"This mode is recommended because expressing foggy, emotional states works best without restrictive visual constraints or harsh structures first.\",\n          alternativeModes: [\"sentence_completion\", \"letter_writing\", \"swipe\"],\n        };\n      } else {\n        return {\n          recommendation: \"quick_fire\",\n          rationale: \"This mode is recommended because quick-fire prompts prompt instant reactions that can break analytical writer\'s block when you\'re feeling foggy.\",\n          alternativeModes: [\"free_stream\", \"guided_drill\", \"sentence_completion\"],\n        };\n      }\n    } else {\n      if (intentType === \"decide\") {\n        return {\n          recommendation: \"binary_frame\",\n          rationale: \"This mode is recommended because bracket/binary comparisons collapse diverging interpretations into a singular core value choice.\",\n          alternativeModes: [\"priority_pile\", \"slider\", \"devils_advocate\"],\n        };\n      } else if (nature === \"emotional\") {\n        return {\n          recommendation: \"guided_drill\",\n          rationale: \"This mode is recommended because structured adaptive questions carefully thread complex internal associations.\",\n          alternativeModes: [\"letter_writing\", \"sentence_completion\", \"timeline\"],\n        };\n      } else {\n        return {\n          recommendation: \"guided_drill\",\n          rationale: \"This mode is recommended because a thorough drill allows you to lay down deep analytical blueprints systematically.\",\n          alternativeModes: [\"card_sort\", \"slider\", \"timeline\"],\n        };\n      }\n    }\n  };\n\n  const handleFetchRecommendation = async () => {\n    setLoadingRecommendation(true);\n    setRecommendationResult(null);\n\n    const actualIntention = intention === \"custom\" ? customIntention : intention;\n\n    try {\n      const response = await fetch(\"/api/session/recommend\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          topic,\n          intention: actualIntention || \"Unclutter scatter and organize core outline\",\n          clarity,\n          nature,\n          timeAvailable,\n          intentType,\n        }),\n      });\n\n      if (response.ok) {\n        const data = await response.json();\n        if (data.recommendation) {\n          setRecommendationResult(data);\n        } else {\n          setRecommendationResult(getQuickRecommendationLocally());\n        }\n      } else {\n        setRecommendationResult(getQuickRecommendationLocally());\n      }\n    } catch (e) {\n      console.error(e);\n      setRecommendationResult(getQuickRecommendationLocally());\n    } finally {\n      setLoadingRecommendation(false);\n    }\n  };\n\n  const handleLaunchWithMode = (mode: ExtractionMode) => {\n    onStartSession({\n      topic: topic || \"Untitled Extraction Session\",\n      intention: intention === \"custom\" ? customIntention : (intention || \"Unclutter scatter\"),\n      activeMode: mode,\n      status: \"active\",\n      warmupAnswers: {\n        clarity,\n        nature,\n        timeAvailable,\n        intentType,\n      },\n    });\n  };\n\n  const isFormValid = topic.trim().length > 0;\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 py-8 md:py-12\" id=\"intake-root\">\n      <div className=\"text-center mb-10 md:mb-12\">\n        <div className=\"inline-flex items-center justify-center bg-indigo-50 border border-indigo-100 rounded-2xl p-4.5 mb-5 shadow-sm text-indigo-600\">\n          <Brain className=\"w-10 h-10 animate-pulse text-indigo-600\" />\n        </div>\n        <h1 className=\"text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl font-sans\">\n          Extraction\n        </h1>\n        <p className=\"mt-4 text-lg text-slate-500 max-w-xl mx-auto\">\n          Unburden, organize, and map out your thoughts. Let\'s move from scattered ideas to structural lists and outlines.\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        {/* Main Intake Block */}\n        <div className=\"lg:col-span-2 space-y-8 bg-white border border-slate-200/80 rounded-2xl p-6 md:p-8 shadow-sm\">\n          <div>\n            <h2 className=\"text-lg font-semibold text-slate-950 flex items-center gap-2 mb-4\">\n              <Clipboard className=\"w-5 h-5 text-indigo-500\" />\n              1. What is this session about?\n            </h2>\n            \n            {/* Presets Grid */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3 mb-4\">\n              {PRESETS.map((p, i) => {\n                const Icon = p.icon;\n                return (\n                  <button\n                    key={i}\n                    onClick={() => handlePresetSelect(p)}\n                    className=\"flex text-left p-3.5 border border-slate-100 rounded-xl hover:border-indigo-400 hover:bg-indigo-50/20 active:bg-indigo-50/50 transition cursor-pointer\"\n                  >\n                    <Icon className=\"w-5 h-5 shrink-0 text-slate-400 mt-0.5 mr-3\" />\n                    <div>\n                      <span className=\"block font-medium text-xs text-slate-800\">{p.topic}</span>\n                      <span className=\"block text-[11px] text-slate-400 font-normal line-clamp-1\">{p.intention}</span>\n                    </div>\n                  </button>\n                );\n              })}\n            </div>\n\n            <textarea\n              id=\"topic-input\"\n              rows={3}\n              placeholder=\"e.g., Deciding on my product release plan, evaluating a hard conversation with my sibling, or putting together a side-project outline...\"\n              value={topic}\n              onChange={(e) => setTopic(e.target.value)}\n              className=\"w-full text-sm border border-slate-200 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 placeholder:text-slate-400 bg-slate-50/30 transition\"\n            />\n          </div>\n\n          <div>\n            <h2 className=\"text-lg font-semibold text-slate-950 flex items-center gap-2 mb-4\">\n              <Smile className=\"w-5 h-5 text-indigo-500\" />\n              2. What do you want to get out of this?\n            </h2>\n            <div className=\"space-y-2\">\n              {[\n                { label: \"Organize raw thoughts into a structured markdown outline\", value: \"Organize raw thoughts into a structured markdown outline\" },\n                { label: \"Make a tough choice with clear priority action items\", value: \"Make a tough choice with clear priority action items\" },\n                { label: \"Decompress deep mental fog and find emotional peace\", value: \"Decompress deep mental fog and find emotional peace\" },\n                { label: \"custom\", labelOverride: \"Something else...\" },\n              ].map((opt) => (\n                <label\n                  key={opt.value || \"custom\"}\n                  className={`flex items-center gap-3 p-3 border rounded-xl cursor-pointer transition text-sm ${\n                    intention === opt.value || (opt.value === \"custom\" && intention === \"custom\")\n                      ? \"border-indigo-500 bg-indigo-50/30 font-medium text-slate-900\"\n                      : \"border-slate-100 hover:bg-slate-50/50 text-slate-600\"\n                  }`}\n                >\n                  <input\n                    type=\"radio\"\n                    name=\"intention\"\n                    checked={intention === opt.value || (opt.value === \"custom\" && intention === \"custom\")}\n                    onChange={() => setIntention(opt.value || \"custom\")}\n                    className=\"text-indigo-600 focus:ring-indigo-500 border-slate-300\"\n                  />\n                  {opt.labelOverride || opt.label}\n                </label>\n              ))}\n\n              <AnimatePresence>\n                {intention === \"custom\" && (\n                  <motion.div\n                    initial={{ opacity: 0, height: 0 }}\n                    animate={{ opacity: 1, height: \"auto\" }}\n                    exit={{ opacity: 0, height: 0 }}\n                    className=\"overflow-hidden\"\n                  >\n                    <input\n                      type=\"text\"\n                      placeholder=\"My custom intention holds...\"\n                      value={customIntention}\n                      onChange={(e) => setCustomIntention(e.target.value)}\n                      className=\"w-full text-sm border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500\"\n                    />\n                  </motion.div>\n                )}\n              </AnimatePresence>\n            </div>\n          </div>\n\n          {/* Launch Buttons / Quiz Toggle */}\n          <div className=\"pt-4 border-t border-slate-100 space-y-4\">\n            {!showRecommendationQuiz ? (\n              <div className=\"flex flex-col sm:flex-row gap-3\">\n                <button\n                  disabled={!isFormValid}\n                  onClick={() => setShowRecommendationQuiz(true)}\n                  className={`flex-1 flex justify-center items-center gap-2 px-5 py-3 rounded-xl border border-indigo-200 text-indigo-700 bg-indigo-50/80 font-medium hover:bg-indigo-50 text-sm cursor-pointer transition ${\n                    !isFormValid ? \"opacity-50 cursor-not-allowed\" : \"\"\n                  }`}\n                >\n                  <Sparkles className=\"w-4 h-4 shrink-0\" />\n                  Guide Me (Recommend a Mode)\n                </button>\n                <button\n                  disabled={!isFormValid}\n                  onClick={() => handleLaunchWithMode(\"free_stream\")}\n                  className={`flex-1 flex justify-center items-center gap-2 px-5 py-3 rounded-xl bg-indigo-600 text-white font-medium hover:bg-indigo-700 text-sm cursor-pointer transition shadow-xs ${\n                    !isFormValid ? \"opacity-50 cursor-not-allowed\" : \"\"\n                  }`}\n                >\n                  Start Instantly (Free Stream)\n                  <ArrowRight className=\"w-4 h-4 shrink-0\" />\n                </button>\n              </div>\n            ) : (\n              <div className=\"space-y-6\">\n                <div className=\"flex justify-between items-center bg-slate-50 p-4 rounded-xl\">\n                  <div>\n                    <h3 className=\"font-semibold text-xs text-slate-800\">Warm-up Diagnostic Quiz</h3>\n                    <p className=\"text-[11px] text-slate-500\">Helps Gemini tune your structured templates.</p>\n                  </div>\n                  <button\n                    onClick={() => setShowRecommendationQuiz(false)}\n                    className=\"text-xs text-indigo-600 hover:underline\"\n                  >\n                    Skip & choose manually\n                  </button>\n                </div>\n\n                <div className=\"space-y-4\">\n                  {/* Q1 */}\n                  <div>\n                    <span className=\"block text-xs font-medium text-slate-600 mb-2\">\n                      \342\200\234Do you feel clear or foggy about this topic?\342\200\235\n                    </span>\n                    <div className=\"flex gap-2\">\n                      {[\n                        { label: \"Mainly Clear\", val: \"clear\" },\n                        { label: \"Mainly Foggy\", val: \"foggy\" },\n                      ].map((o) => (\n                        <button\n                          key={o.val}\n                          onClick={() => setClarity(o.val as any)}\n                          className={`flex-1 py-2 text-xs border rounded-lg transition ${\n                            clarity === o.val\n                              ? \"bg-indigo-600 text-white border-indigo-600 font-medium shadow-xs\"\n                              : \"bg-white border-slate-200 text-slate-600 hover:bg-slate-50\"\n                          }`}\n                        >\n                          {o.label}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n\n                  {/* Q2 */}\n                  <div>\n                    <span className=\"block text-xs font-medium text-slate-600 mb-2\">\n                      \342\200\234Is this core issue more emotional or analytical?\342\200\235\n                    </span>\n                    <div className=\"flex gap-2\">\n                      {[\n                        { label: \"Analytical\", val: \"analytical\" },\n                        { label: \"Emotional / Felt\", val: \"emotional\" },\n                      ].map((o) => (\n                        <button\n                          key={o.val}\n                          onClick={() => setNature(o.val as any)}\n                          className={`flex-1 py-2 text-xs border rounded-lg transition ${\n                            nature === o.val\n                              ? \"bg-indigo-600 text-white border-indigo-600 font-medium shadow-xs\"\n                              : \"bg-white border-slate-200 text-slate-600 hover:bg-slate-50\"\n                          }`}\n                        >\n                          {o.label}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n\n                  {/* Q3 */}\n                  <div>\n                    <span className=\"block text-xs font-medium text-slate-600 mb-2\">\n                      \342\200\234How much time do you have right now?\342\200\235\n                    </span>\n                    <div className=\"flex gap-2\">\n                      {[\n                        { label: \"< 5 Mins (Quick check)\", val: \"<5\" },\n                        { label: \"> 20 Mins (Deep structured block)\", val: \">20\" },\n                      ].map((o) => (\n                        <button\n                          key={o.val}\n                          onClick={() => setTimeAvailable(o.val as any)}\n                          className={`flex-1 py-2 text-xs border rounded-lg transition ${\n                            timeAvailable === o.val\n                              ? \"bg-indigo-600 text-white border-indigo-600 font-medium shadow-xs\"\n                              : \"bg-white border-slate-200 text-slate-600 hover:bg-slate-50\"\n                          }`}\n                        >\n                          {o.label}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n\n                  {/* Q4 */}\n                  <div>\n                    <span className=\"block text-xs font-medium text-slate-600 mb-2\">\n                      \342\200\234Are you trying to decide, process, or just capture?\342\200\235\n                    </span>\n                    <div className=\"flex gap-2\">\n                      {[\n                        { label: \"Decide\", val: \"decide\" },\n                        { label: \"Process\", val: \"process\" },\n                        { label: \"Capture\", val: \"capture\" },\n                      ].map((o) => (\n                        <button\n                          key={o.val}\n                          onClick={() => setIntentType(o.val as any)}\n                          className={`flex-1 py-2 text-xs border rounded-lg transition ${\n                            intentType === o.val\n                              ? \"bg-indigo-600 text-white border-indigo-600 font-medium shadow-xs\"\n                              : \"bg-white border-slate-200 text-slate-600 hover:bg-slate-50\"\n                          }`}\n                        >\n                          {o.label}\n                        </button>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"pt-3 border-t border-slate-100 flex gap-3\">\n                  <button\n                    onClick={() => setShowRecommendationQuiz(false)}\n                    className=\"flex-1 py-2 rounded-lg border border-slate-100 font-medium text-slate-500 hover:bg-slate-50 text-xs transition cursor-pointer text-center\"\n                  >\n                    Back\n                  </button>\n                  <button\n                    disabled={!clarity || !nature || !timeAvailable || !intentType || loadingRecommendation}\n                    onClick={handleFetchRecommendation}\n                    className={`flex-1 flex justify-center items-center gap-1 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium text-xs shadow-xs cursor-pointer transition ${\n                      (!clarity || !nature || !timeAvailable || !intentType || loadingRecommendation) ? \"opacity-50 cursor-not-allowed\" : \"\"\n                    }`}\n                  >\n                    {loadingRecommendation ? \"Determining...\" : \"Get Recommend Mode\"}\n                  </button>\n                </div>\n\n                {/* Recommendation Result Presentation */}\n                {recommendationResult && (\n                  <motion.div\n                    initial={{ opacity: 0, y: 10 }}\n                    animate={{ opacity: 1, y: 0 }}\n                    className=\"p-5 bg-indigo-50 border border-indigo-100 rounded-xl space-y-4\"\n                  >\n                    <div className=\"flex justify-between items-start\">\n                      <div>\n                        <span className=\"text-[10px] uppercase font-bold tracking-wider text-indigo-500\">AI Recommended Mode</span>\n                        <h4 className=\"text-sm font-bold text-slate-900 capitalize mt-1\">\n                          {recommendationResult.recommendation.replace(\"_\", \" \")}\n                        </h4>\n                      </div>\n                      <span className=\"bg-indigo-200 text-indigo-800 text-[10px] px-2 py-0.5 rounded-full font-semibold\">98% Match</span>\n                    </div>\n                    <p className=\"text-xs text-slate-600 italic leading-relaxed\">\n                      \"{recommendationResult.rationale}\"\n                    </p>\n\n                    <div className=\"flex flex-col sm:flex-row gap-2 pt-2\">\n                      <button\n                        onClick={() => handleLaunchWithMode(recommendationResult.recommendation)}\n                        className=\"flex-1 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium text-xs cursor-pointer transition shadow-xs text-center\"\n                      >\n                        Accept & Launch Recommended\n                      </button>\n                      \n                      <div className=\"flex gap-2\">\n                        {recommendationResult.alternativeModes.slice(0, 2).map((alt) => (\n                          <button\n                            key={alt}\n                            onClick={() => handleLaunchWithMode(alt)}\n                            className=\"bg-white border border-indigo-200 text-indigo-700 rounded-lg py-2.5 px-3 hover:bg-indigo-50/50 text-[10px] font-medium capitalize cursor-pointer transition\"\n                          >\n                            Use {alt.replace(\"_\", \" \")}\n                          </button>\n                        ))}\n                      </div>\n                    </div>\n                  </motion.div>\n                )}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* History / Sessions Sidebar */}\n        <div className=\"bg-slate-50/70 border border-slate-200/80 rounded-2xl p-5 md:p-6 shadow-sm flex flex-col h-full max-h-[600px] overflow-hidden\">\n          <h2 className=\"text-base font-semibold text-slate-950 flex items-center gap-2 mb-3 shrink-0\">\n            <FolderOpen className=\"w-5 h-5 text-indigo-500\" />\n            Previous Sessions\n          </h2>\n          <p className=\"text-xs text-slate-500 mb-4 shrink-0\">\n            Open past Extractions to continue or view organized summaries.\n          </p>\n\n          <div className=\"flex-1 overflow-y-auto space-y-2 pr-1 custom-scrollbar\">\n            {pastSessions.length === 0 ? (\n              <div className=\"text-center py-12 text-slate-400\">\n                <Brain className=\"w-8 h-8 mx-auto stroke-1 opacity-40 mb-2\" />\n                <p className=\"text-[11px]\">No saved extraction sessions yet.</p>\n              </div>\n            ) : (\n              pastSessions.map((session) => (\n                <div\n                  key={session.id}\n                  className=\"flex justify-between items-center bg-white border border-slate-100 rounded-xl p-3 hover:border-indigo-300 hover:shadow-xs transition group\"\n                >\n                  <button\n                    onClick={() => onLoadSession(session.id)}\n                    className=\"flex-1 text-left min-w-0\"\n                  >\n                    <span className=\"block font-medium text-xs text-slate-800 truncate mb-0.5\">\n                      {session.topic}\n                    </span>\n                    <span className=\"block text-[10px] text-slate-400\">\n                      {session.thoughts.length} thoughts surfaced \342\200\242 {new Date(session.updatedAt).toLocaleDateString()}\n                    </span>\n                  </button>\n                  <button\n                    onClick={() => onDeleteSession(session.id)}\n                    className=\"text-slate-300 hover:text-red-500 ml-1 p-1 hover:bg-slate-50 rounded-lg group-hover:opacity-100 transition duration-150 cursor-pointer\"\n                    title=\"Delete session\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              ))\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
