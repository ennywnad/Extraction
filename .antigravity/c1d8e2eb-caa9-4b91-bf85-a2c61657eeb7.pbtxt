  file_change {
    absolute_path_uri: "file:///src/components/Workspace.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState } from \"react\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport {\n  ArrowLeft,\n  Settings,\n  Brain,\n  ListFilter,\n  CheckCircle,\n  HelpCircle,\n  Trash2,\n  Edit2,\n  Layers,\n  Sparkles,\n  RefreshCw,\n  Plus,\n  BookOpen\n} from \"lucide-react\";\nimport { Session, Thought, ExtractionMode } from \"../types\";\n\ninterface WorkspaceProps {\n  session: Session;\n  onUpdateSession: (updates: Partial<Session>) => void;\n  onExit: () => void;\n  onSynthesize: () => void;\n  children: React.ReactNode;\n}\n\nexport default function Workspace({\n  session,\n  onUpdateSession,\n  onExit,\n  onSynthesize,\n  children,\n}: WorkspaceProps) {\n  const [editingThoughtId, setEditingThoughtId] = useState<string | null>(null);\n  const [editText, setEditText] = useState(\"\");\n  const [filterTags, setFilterTags] = useState<ExtractionMode | \"all\">(\"all\");\n  const [newThoughtText, setNewThoughtText] = useState(\"\");\n  const [showDirectInput, setShowDirectInput] = useState(false);\n\n  // Switch modes\n  const handleModeSwitch = (mode: ExtractionMode) => {\n    onUpdateSession({\n      activeMode: mode,\n      modeHistory: [...session.modeHistory, { mode, timestamp: new Date().toISOString() }],\n    });\n  };\n\n  const handleDeleteThought = (id: string) => {\n    onUpdateSession({\n      thoughts: session.thoughts.filter((t) => t.id !== id),\n    });\n  };\n\n  const handleStartEdit = (thought: Thought) => {\n    setEditingThoughtId(thought.id);\n    setEditText(thought.text);\n  };\n\n  const handleSaveEdit = (id: string) => {\n    onUpdateSession({\n      thoughts: session.thoughts.map((t) => (t.id === id ? { ...t, text: editText } : t)),\n    });\n    setEditingThoughtId(null);\n  };\n\n  const handleAddDirectThought = () => {\n    if (!newThoughtText.trim()) return;\n    const newThought: Thought = {\n      id: Math.random().toString(),\n      text: newThoughtText.trim(),\n      timestamp: new Date().toISOString(),\n      mode: session.activeMode,\n    };\n    onUpdateSession({\n      thoughts: [newThought, ...session.thoughts],\n    });\n    setNewThoughtText(\"\");\n    setShowDirectInput(false);\n  };\n\n  const modesList: { mode: ExtractionMode; label: string; desc: string; color: string }[] = [\n    { mode: \"free_stream\", label: \"Free Stream\", desc: \"No prompts, unfiltered typing\", color: \"from-amber-400 to-orange-500\" },\n    { mode: \"quick_fire\", label: \"Quick Fire\", desc: \"Speed questions, brief answers\", color: \"from-red-500 to-pink-500\" },\n    { mode: \"guided_drill\", label: \"Guided Drill\", desc: \"Adaptive expert interview\", color: \"from-blue-500 to-indigo-600\" },\n    { mode: \"binary_frame\", label: \"Binary Bracket\", desc: \"Choose contrasting framings\", color: \"from-emerald-500 to-teal-600\" },\n    { mode: \"swipe\", label: \"Swipe Statements\", desc: \"Mark statements that resonate\", color: \"from-purple-500 to-indigo-500\" },\n    { mode: \"slider\", label: \"Intensity Map\", desc: \"Rate importance & urgency levels\", color: \"from-indigo-500 to-purple-600\" },\n    { mode: \"card_sort\", label: \"Cluster Sorting\", desc: \"Sort thoughts into folders\", color: \"from-teal-400 to-cyan-500\" },\n    { mode: \"timeline\", label: \"Temporal Map\", desc: \"Organize past, present & futures\", color: \"from-rose-400 to-red-500\" },\n    { mode: \"sentence_completion\", label: \"Sentence Starters\", desc: \"Uncover blocked views\", color: \"from-violet-500 to-fuchsia-600\" },\n    { mode: \"devils_advocate\", label: \"Advocate Shock\", desc: \"Deconstruct your defense\", color: \"from-amber-600 to-red-700\" },\n    { mode: \"letter_writing\", label: \"Letter Drill\", desc: \"Address the deep feelings\", color: \"from-orange-400 to-amber-600\" },\n    { mode: \"priority_pile\", label: \"Priority Eisenhower\", desc: \"Group urgent decision variables\", color: \"from-teal-600 to-emerald-700\" }\n  ];\n\n  const filteredThoughts = session.thoughts.filter(\n    (t) => filterTags === \"all\" || t.mode === filterTags\n  );\n\n  return (\n    <div className=\"flex flex-col h-[calc(100vh-10px)] max-h-[1400px] overflow-hidden bg-slate-50 font-sans\" id=\"workspace-root\">\n      \n      {/* Dynamic Session Sticky Header Banner */}\n      <header className=\"bg-white border-b border-slate-200 px-6 py-4 shrink-0 flex flex-col md:flex-row gap-4 items-center justify-between shadow-xs\">\n        <div className=\"flex items-center gap-4 w-full md:w-auto\">\n          <button\n            onClick={onExit}\n            className=\"p-2 border border-slate-200 rounded-xl hover:bg-slate-50 text-slate-500 transition cursor-pointer\"\n            title=\"Return to Dashboard\"\n          >\n            <ArrowLeft className=\"w-4 h-4\" />\n          </button>\n          <div className=\"min-w-0\">\n            <h2 className=\"text-sm font-semibold text-slate-900 truncate\">\n              {session.topic}\n            </h2>\n            <p className=\"text-[11px] text-slate-500 truncate mt-0.5\">\n              Intention: <strong className=\"text-slate-700 font-normal\">{session.intention}</strong>\n            </p>\n          </div>\n        </div>\n\n        {/* Action button header */}\n        <div className=\"flex items-center gap-2 w-full md:w-auto justify-end\">\n          <button\n            onClick={() => setShowDirectInput((prev) => !prev)}\n            className=\"px-3 py-1.5 border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-medium flex items-center gap-1.5 cursor-pointer transition\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            Scratch Note\n          </button>\n          \n          <button\n            onClick={onSynthesize}\n            className=\"px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-semibold flex items-center gap-2 cursor-pointer shadow-xs transition\"\n          >\n            <Sparkles className=\"w-3.5 h-3.5\" />\n            Finish & Organize Outline\n          </button>\n        </div>\n      </header>\n\n      {/* Direct Thought Intake Modal-bar */}\n      <AnimatePresence>\n        {showDirectInput && (\n          <motion.div\n            initial={{ opacity: 0, y: -10 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -10 }}\n            className=\"bg-indigo-50/60 border-b border-indigo-100 p-3.5 flex items-center gap-2.5 shrink-0\"\n          >\n            <input\n              type=\"text\"\n              placeholder=\"Jot down a quick thought fragment instantly...\"\n              value={newThoughtText}\n              onChange={(e) => setNewThoughtText(e.target.value)}\n              onKeyDown={(e) => e.key === \"Enter\" && handleAddDirectThought()}\n              className=\"flex-1 text-xs border border-indigo-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-indigo-500 bg-white\"\n            />\n            <button\n              onClick={handleAddDirectThought}\n              className=\"px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-medium rounded-lg cursor-pointer transition\"\n            >\n              Add\n            </button>\n            <button\n              onClick={() => setShowDirectInput(false)}\n              className=\"text-xs text-slate-400 hover:text-slate-600 px-1\"\n            >\n              Cancel\n            </button>\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* Mode Selector Horizontal Scrollable Tape */}\n      <div className=\"bg-slate-100 border-b border-slate-200/50 px-6 py-2.5 shrink-0 overflow-x-auto flex items-center gap-2 custom-scrollbar\">\n        <span className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider mr-2 shrink-0 flex items-center gap-1\">\n          <Layers className=\"w-3.5 h-3.5\" />\n          Jump Mode:\n        </span>\n        {modesList.map((m) => {\n          const isActive = session.activeMode === m.mode;\n          return (\n            <button\n              key={m.mode}\n              onClick={() => handleModeSwitch(m.mode)}\n              title={m.desc}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap cursor-pointer transition flex items-center gap-1.5 ${\n                isActive\n                  ? \"bg-white text-slate-900 border border-indigo-400/30 shadow-xs\"\n                  : \"text-slate-500 hover:text-slate-900 hover:bg-slate-250/20\"\n              }`}\n            >\n              <div className={`w-2 h-2 rounded-full bg-linear-to-r ${m.color}`} />\n              {m.label}\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Split Workspace Layout */}\n      <div className=\"flex-1 flex overflow-hidden\">\n        \n        {/* Main Mode Interactive Playground area */}\n        <main className=\"flex-1 p-6 overflow-y-auto bg-white flex flex-col justify-between\">\n          <div className=\"max-w-3xl mx-auto w-full flex-1 flex flex-col\">\n            {children}\n          </div>\n        </main>\n\n        {/* Surfaced Thoughts Sidebar (Real-time pile) */}\n        <aside className=\"w-80 md:w-96 border-l border-slate-200 bg-slate-50 flex flex-col h-full overflow-hidden shrink-0\">\n          \n          {/* Sidebar title */}\n          <div className=\"p-4 border-b border-slate-200 bg-white flex items-center justify-between shrink-0\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"p-1 px-2.5 bg-indigo-50 border border-indigo-100 rounded-lg text-indigo-600 text-xs font-extrabold\">\n                {session.thoughts.length}\n              </div>\n              <h3 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider\">\n                Surfaced Pile\n              </h3>\n            </div>\n            \n            {/* Filter tags config */}\n            <div className=\"flex items-center gap-1\">\n              <ListFilter className=\"w-3.5 h-3.5 text-slate-400\" />\n              <select\n                value={filterTags}\n                onChange={(e) => setFilterTags(e.target.value as any)}\n                className=\"text-[10px] bg-transparent border-0 font-medium text-slate-500 focus:ring-0 outline-none pr-4\"\n              >\n                <option value=\"all\">All Modes</option>\n                <option value=\"free_stream\">Free Stream</option>\n                <option value=\"quick_fire\">Quick Fire</option>\n                <option value=\"guided_drill\">Guided Drill</option>\n                <option value=\"binary_frame\">Binary Frame</option>\n                <option value=\"swipe\">Swipped</option>\n                <option value=\"slider\">Sliders</option>\n                <option value=\"card_sort\">Sorted</option>\n              </select>\n            </div>\n          </div>\n\n          {/* Core Pile scroll content */}\n          <div className=\"flex-1 overflow-y-auto p-4 space-y-3 custom-scrollbar\">\n            {filteredThoughts.length === 0 ? (\n              <div className=\"text-center py-24 text-slate-400\">\n                <Brain className=\"w-10 h-10 mx-auto opacity-30 stroke-1 mb-2\" />\n                <p className=\"text-xs\">Your surfaced thoughts appear here.</p>\n                <p className=\"text-[10px] text-slate-400 mt-1\">Start answering prompts or type in Free Stream mode to stockpile concepts.</p>\n              </div>\n            ) : (\n              filteredThoughts.map((thought, idx) => {\n                const thoughtColorClass = modesList.find((m) => m.mode === thought.mode)?.color || \"from-slate-400 to-slate-500\";\n                \n                return (\n                  <motion.div\n                    key={thought.id}\n                    layoutId={`thought-${thought.id}`}\n                    initial={{ opacity: 0, x: 20 }}\n                    animate={{ opacity: 1, x: 0 }}\n                    exit={{ opacity: 0, x: -20 }}\n                    className=\"p-3 bg-white border border-slate-100 rounded-xl hover:border-slate-300 shadow-2xs hover:shadow-xs transition duration-150 flex flex-col justify-between gap-2.5 relative group\"\n                  >\n                    {/* Header bar metadata */}\n                    <div className=\"flex justify-between items-center shrink-0\">\n                      <span className=\"flex items-center gap-1.5 text-[9px] uppercase tracking-wider font-extrabold text-slate-400\">\n                        <div className={`w-1.5 h-1.5 rounded-full bg-linear-to-r ${thoughtColorClass}`} />\n                        {thought.mode.replace(\"_\", \" \")}\n                      </span>\n                      <span className=\"text-[9px] text-slate-400\">\n                        #{session.thoughts.length - idx}\n                      </span>\n                    </div>\n\n                    {/* Thought Content Body */}\n                    {editingThoughtId === thought.id ? (\n                      <div className=\"space-y-2\">\n                        <textarea\n                          rows={2}\n                          value={editText}\n                          onChange={(e) => setEditText(e.target.value)}\n                          className=\"w-full text-xs p-1.5 border border-slate-200 rounded-md focus:outline-none focus:ring-1 focus:ring-indigo-500 text-slate-800\"\n                        />\n                        <div className=\"flex justify-end gap-1.5 text-[10px]\">\n                          <button\n                            onClick={() => setEditingThoughtId(null)}\n                            className=\"text-slate-450 hover:text-slate-600 px-1\"\n                          >\n                            Cancel\n                          </button>\n                          <button\n                            onClick={() => handleSaveEdit(thought.id)}\n                            className=\"bg-indigo-600 hover:bg-indigo-700 text-white rounded-md px-2 py-1 font-semibold\"\n                          >\n                            Save\n                          </button>\n                        </div>\n                      </div>\n                    ) : (\n                      <div>\n                        <p className=\"text-xs text-slate-700 leading-normal font-normal whitespace-pre-wrap\">\n                          {thought.text}\n                        </p>\n                        \n                        {/* Display extra parameters based on tagging status */}\n                        {thought.swipeStatus && (\n                          <div className=\"mt-1.5 inline-flex items-center gap-1 rounded bg-slate-50 px-1.5 py-0.5 text-[9px] font-bold text-slate-500 capitalize\">\n                            Status: {thought.swipeStatus === \"like\" ? \"Resonates\" : thought.swipeStatus === \"dislike\" ? \"Rejected\" : \"Maybe\"}\n                          </div>\n                        )}\n\n                        {thought.intensity && (\n                          <div className=\"mt-1.5 flex flex-wrap gap-1\">\n                            {Object.entries(thought.intensity).map(([k, v]) => (\n                              <span key={k} className=\"bg-indigo-50 border border-indigo-100 text-indigo-700 px-1 py-0.5 text-[8px] rounded font-bold capitalize\">\n                                {k}: {v}/10\n                              </span>\n                            ))}\n                          </div>\n                        )}\n\n                        {thought.clusterCategory && (\n                          <div className=\"mt-1.5 inline-flex items-center gap-1 bg-teal-50 border border-teal-100 p-0.5 px-1.5 rounded text-[8px] font-extrabold text-teal-700 capitalize\">\n                            Cluster: {thought.clusterCategory}\n                          </div>\n                        )}\n\n                        {thought.timelineZone && (\n                          <div className=\"mt-1.5 inline-flex items-center gap-1 bg-rose-50 border border-rose-100 p-0.5 px-1.5 rounded text-[8px] font-extrabold text-rose-700 capitalize\">\n                            Timeline: {thought.timelineZone}\n                          </div>\n                        )}\n\n                        {thought.priorityZone && (\n                          <div className=\"mt-1.5 inline-flex items-center gap-1 bg-teal-50 border border-teal-150 p-0.5 px-1.5 rounded text-[8px] font-extrabold text-teal-800 capitalize\">\n                            Priority: {thought.priorityZone === \"act\" ? \"Act On This\" : thought.priorityZone === \"watch\" ? \"Worth Watching\" : \"Discard\"}\n                          </div>\n                        )}\n                      </div>\n                    )}\n\n                    {/* Operational edit overlay on hover */}\n                    <div className=\"absolute right-2 top-2 opacity-0 group-hover:opacity-100 transition duration-150 flex items-center bg-white px-1 py-0.5 border border-slate-100 rounded-md shadow-2xs gap-1 shrink-0\">\n                      <button\n                        onClick={() => handleStartEdit(thought)}\n                        className=\"p-1 hover:text-indigo-600 text-slate-400 rounded-md hover:bg-slate-50\"\n                        title=\"Edit thought\"\n                      >\n                        <Edit2 className=\"w-3 h-3\" />\n                      </button>\n                      <button\n                        onClick={() => handleDeleteThought(thought.id)}\n                        className=\"p-1 hover:text-red-500 text-slate-400 rounded-md hover:bg-slate-50\"\n                        title=\"Delete thought\"\n                      >\n                        <Trash2 className=\"w-3 h-3\" />\n                      </button>\n                    </div>\n                  </motion.div>\n                );\n              })\n            )}\n          </div>\n\n          {/* Quick guide bottom block */}\n          <div className=\"p-4 bg-white border-t border-slate-200 shrink-0 text-center\">\n            <p className=\"text-[10px] text-slate-400\">\n              Gather 5+ thoughts for optimal Markdown structure summary.\n            </p>\n          </div>\n        </aside>\n      </div>\n    </div>\n  );\n}\n"
    }
