          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    navigator.clipboard.writeText(text);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    setCopied(true);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    setTimeout(() => setCopied(false), 2000);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
