# Local development. Copy to .env and fill in.
# Production values are set by scripts/deploy.sh; see DEPLOYMENT.md.

# --- Identity -------------------------------------------------------------
# iap  = verify the X-Goog-IAP-JWT-Assertion header (production; the default)
# dev  = trust DEV_USER_* below. Refused when NODE_ENV=production.
AUTH_MODE="dev"
DEV_USER_EMAIL="you@example.com"
DEV_USER_NAME="Your Name"

# Set by deploy.sh in production; format is
#   /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
# Required whenever AUTH_MODE=iap. Leave empty locally.
IAP_AUDIENCE=""

# --- Storage --------------------------------------------------------------
# Empty locally: engagements fall back to a JSON file under .data/.
# Set to a project id in production to use Firestore.
FIRESTORE_PROJECT_ID=""

# --- Gemini ---------------------------------------------------------------
# apikey = Gemini Developer API with the key below (easiest for local dev)
# vertex = Vertex AI as the runtime service account via ADC (production; no key material)
GENAI_BACKEND="apikey"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# vertex only. Where Gemini is served from — a region id, or "global".
#
# `global` routes to whatever region has capacity, so it takes fewer 429s and gets new model
# ids first; for stable versions the per-token price is the same either way. A region id
# pins where prompts are served, which is what you want if a client requires residency.
# scripts/deploy.sh currently passes $REGION here, so a deployment inherits the Cloud Run
# region unless you change it.
#
# Not to be confused with Vertex Flex PayGo, which is genuinely half price, global-only, and
# targets 1-15 MINUTE responses. That is unusable for an interactive prompt.
VERTEX_LOCATION=""

# Models to try in order, comma-separated. Empty uses the built-in default in
# server/ai/client.ts, which is currently:
#
#   gemini-3.5-flash,gemini-3.5-flash-lite
#
# **Verify these before trusting them.** Valid ids differ between the two backends and are
# retired on published dates. This default was checked against the Vertex release notes on
# 2026-09-03, replacing a chain whose fallback tier had been shut down three months earlier
# without anything here noticing.
#
# The failure mode is quiet and costs latency rather than erroring cleanly: a retired id
# answers 404, which is not fatal to the chain, so the request tries the next model and only
# then fails. Two dead ids means two round trips per request to reach "All models failed".
GEMINI_MODELS=""
